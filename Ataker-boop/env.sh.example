# Скопируй на Air: cp Ataker-boop/env.sh.example ~/Ataker-SSD/env.sh
# и подставь id из LM Studio после Load. Потом: source ~/Ataker-SSD/env.sh
#
# Готовка моделей — до боя. Не запускает удары по Крепости.

export ATAKER_LMSTUDIO_URL="${ATAKER_LMSTUDIO_URL:-http://127.0.0.1:1234/v1}"
export ATAKER_JUDGE_URL="${ATAKER_JUDGE_URL:-http://127.0.0.1:1234}"

# Творец (Planner) = Dolphin3-Cyber-8B Q4_K_M
export ATAKER_PLANNER_MODEL="${ATAKER_PLANNER_MODEL:-REPLACE_WITH_LMS_PLANNER_ID}"

# Исполнитель (Executor) = Llama-3.2-3B-Instruct-abliterated Q4_K_M
export ATAKER_EXECUTOR_MODEL="${ATAKER_EXECUTOR_MODEL:-REPLACE_WITH_LMS_EXECUTOR_ID}"

# UCS judge пока = Planner
export ATAKER_JUDGE_MODEL="${ATAKER_JUDGE_MODEL:-$ATAKER_PLANNER_MODEL}"

# Песочница (когда дойдёте до smoke — не сейчас)
export KREPOST_SANDBOX_URL="${KREPOST_SANDBOX_URL:-http://127.0.0.1:8010}"
