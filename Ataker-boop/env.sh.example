# Скопируй на Air SSD или:
#   source /Volumes/AtakerDirty/Ataker/env.fortress.sh
#
# Готовка моделей — до боя. Не запускает удары по Крепости.
# Удары по Studio только с FORCE_STUDIO=1 (см. scripts/smoke_studio.sh).

export ATAKER_SSD="${ATAKER_SSD:-/Volumes/AtakerDirty/Ataker}"
export FORTRESS_DATA="${FORTRESS_DATA:-$ATAKER_SSD/fortress_data/attacker}"
export ATAKER_VAULT="${ATAKER_VAULT:-$ATAKER_SSD/ataker_vault/attacks.db}"
export ATAKER_REPORTS="${ATAKER_REPORTS:-$ATAKER_SSD/reports}"
export ATAKER_SECRETS="${ATAKER_SECRETS:-$HOME/.ataker}"

export ATAKER_LMSTUDIO_URL="${ATAKER_LMSTUDIO_URL:-http://127.0.0.1:1234/v1}"
export ATAKER_JUDGE_URL="${ATAKER_JUDGE_URL:-http://127.0.0.1:1234}"

# Planner: стабильный uncensored id из LM Studio (после скачивания)
export ATAKER_PLANNER_MODEL="${ATAKER_PLANNER_MODEL:-REPLACE_WITH_STABLE_UNCENSORED_ID}"
# Executor: 3B abliterated
export ATAKER_EXECUTOR_MODEL="${ATAKER_EXECUTOR_MODEL:-llama-3.2-3b-instruct-abliterated}"
export ATAKER_JUDGE_MODEL="${ATAKER_JUDGE_MODEL:-$ATAKER_PLANNER_MODEL}"

export KREPOST_STUDIO_URL="${KREPOST_STUDIO_URL:-http://10.0.0.1:8000}"
export KREPOST_SANDBOX_URL="${KREPOST_SANDBOX_URL:-http://127.0.0.1:8010}"
export ROUNDTABLE_PORT="${ROUNDTABLE_PORT:-8011}"
